nextflow.enable.dsl = 2

manifest {
    name = 'Topyfic Nextflow Workflow'
    description = 'Nextflow DSL2 pipeline for Topyfic train/topModel/analysis generation'
    mainScript = 'main.nf'
}

params {
    names = []
    count_adata = [:]
    n_topics = []
    organism = null
    workdir = "${projectDir}/results"
    train = [
        backend: 'default',
        device: 'auto',
        dtype: 'float32',
        random_states: [0],
        batch_size: 128,
        max_iter: 5,
        n_jobs: 1,
    ]
    top_model = [
        n_top_genes: null,
        resolution: 1,
        max_iter_harmony: 10,
        min_cell_participation: null,
    ]
    plotting = [
        interactive: false,
    ]
    merge = false
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
}